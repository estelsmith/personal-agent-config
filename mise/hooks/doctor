#!/usr/bin/env python3
"""Health check hook for mise (~/bin/mise, ~/.bash_profile hook, and global tools)."""

from __future__ import annotations

import os
import sys
from pathlib import Path

from _mise import (
    check_bash_profile,
    check_global_tools,
    check_mise_binary,
    load_desired_tools,
)


def main() -> int:
    home = Path.home()
    system_dir = Path(os.environ.get("SYSTEM_DIR") or Path(__file__).resolve().parent.parent)
    mise_bin = home / "bin" / "mise"
    bash_profile = home / ".bash_profile"
    config_toml = home / ".config" / "mise" / "config.toml"

    ok = True

    bin_ok, bin_msg = check_mise_binary(mise_bin)
    print(bin_msg)
    if not bin_ok:
        ok = False

    prof_ok, prof_msg = check_bash_profile(bash_profile)
    print(prof_msg)
    if not prof_ok:
        ok = False

    try:
        desired_tools = load_desired_tools(system_dir)
    except Exception as exc:
        print(f"[FAIL] could not load mise/tools.toml: {exc}")
        return 1

    if bin_ok:
        tools_ok, tool_msgs = check_global_tools(mise_bin, config_toml, desired_tools, home)
        for msg in tool_msgs:
            print(msg)
        if not tools_ok:
            ok = False

    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
