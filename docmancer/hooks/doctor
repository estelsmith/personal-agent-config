#!/usr/bin/env python3
"""Health check hook for docmancer (Mise environment injection and `mise exec -- docmancer`).

Verifies the Mise toolchain, the LiteLLM proxy env vars from `docmancer.toml`,
and that `docmancer` actually ships the `openai` and `socks` extras it needs.
"""

from __future__ import annotations

import json
import os
import shlex
import subprocess
import sys
from pathlib import Path


def _read_shebang_interpreter(script_path: Path) -> str | None:
    """Extract the Python interpreter from `script_path`'s shebang.

    Probes that exact interpreter instead of relying on global PATH, since
    `pipx:docmancer` runs inside its own Mise-managed virtualenv.
    """
    if not script_path.is_file():
        return None
    try:
        with script_path.open("rb") as fh:
            first_line = fh.readline(4096).decode("utf-8", errors="replace").strip()
    except OSError:
        return None
    if not first_line.startswith("#!"):
        return None
    tokens = shlex.split(first_line[2:].strip())
    if not tokens:
        return None
    interp = tokens[0]
    if interp == "/usr/bin/env" and len(tokens) > 1:
        return tokens[1]
    return interp


def main() -> int:
    """Check `~/bin/mise`, Mise env vars, and `docmancer` extras."""
    home = Path.home()
    mise_bin = home / "bin" / "mise"

    if not (mise_bin.is_file() and os.access(mise_bin, os.X_OK)):
        print("[FAIL] ~/bin/mise is not installed or not executable (run bin/install mise)")
        return 1

    ok = True

    env_res = subprocess.run(
        [str(mise_bin), "env", "--json"],
        cwd=str(home),
        capture_output=True,
        text=True,
    )
    if env_res.returncode != 0:
        err = env_res.stderr.strip() or f"exit {env_res.returncode}"
        print(f"[FAIL] mise env --json failed: {err}")
        ok = False
    else:
        try:
            mise_env = json.loads(env_res.stdout or "{}")
        except json.JSONDecodeError as exc:
            print(f"[FAIL] invalid JSON from mise env --json: {exc}")
            mise_env = {}
            ok = False

        if isinstance(mise_env, dict):
            missing = [
                key
                for key in ("OPENAI_BASE_URL", "OPENAI_API_KEY")
                if not str(mise_env.get(key, "")).strip()
            ]
            if missing:
                print(
                    f"[FAIL] Mise environment missing {', '.join(missing)} "
                    "(expected via ~/.config/mise/conf.d/docmancer.toml)"
                )
                ok = False
            else:
                print(
                    f"[OK] Mise environment defines OPENAI_BASE_URL={mise_env['OPENAI_BASE_URL']} "
                    "and OPENAI_API_KEY"
                )

    doc_res = subprocess.run(
        [str(mise_bin), "exec", "--", "docmancer", "--version"],
        cwd=str(home),
        capture_output=True,
        text=True,
    )
    if doc_res.returncode != 0:
        err = doc_res.stderr.strip() or doc_res.stdout.strip() or f"exit {doc_res.returncode}"
        print(f"[FAIL] mise exec -- docmancer --version failed: {err}")
        ok = False
    else:
        ver = doc_res.stdout.strip().splitlines()[0] if doc_res.stdout.strip() else "unknown"
        print(f"[OK] mise exec -- docmancer ({ver})")

        which_res = subprocess.run(
            [str(mise_bin), "which", "docmancer"],
            cwd=str(home),
            capture_output=True,
            text=True,
        )
        if which_res.returncode != 0 or not which_res.stdout.strip():
            err = which_res.stderr.strip() or f"exit {which_res.returncode}"
            print(f"[FAIL] mise which docmancer failed: {err}")
            ok = False
        else:
            doc_bin = Path(which_res.stdout.strip().splitlines()[0])
            interp = _read_shebang_interpreter(doc_bin)
            if interp is None:
                print(
                    f"[FAIL] could not determine Python interpreter for {doc_bin} "
                    "to verify 'embeddings-openai' extra and 'pysocks' dependency"
                )
                ok = False
            else:
                imp_res = subprocess.run(
                    [interp, "-c", "import openai"],
                    cwd=str(home),
                    capture_output=True,
                    text=True,
                )
                if imp_res.returncode != 0:
                    print(
                        "[FAIL] docmancer is missing the 'embeddings-openai' extra "
                        "(run bin/install mise or ~/bin/mise install --force pipx:docmancer)"
                    )
                    ok = False
                else:
                    print("[OK] docmancer embeddings-openai extra (openai) is installed")

                socks_res = subprocess.run(
                    [interp, "-c", "import socks"],
                    cwd=str(home),
                    capture_output=True,
                    text=True,
                )
                if socks_res.returncode != 0:
                    print(
                        "[FAIL] docmancer is missing the 'pysocks' dependency "
                        "(run bin/install mise or ~/bin/mise install --force pipx:docmancer)"
                    )
                    ok = False
                else:
                    print("[OK] docmancer pysocks dependency (socks) is installed")

    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
