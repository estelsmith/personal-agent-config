#!/usr/bin/env python3
"""Health check hook for `junie` (`~/.junie/AGENTS.md` rendered from `junie/rules/*.md`)."""

from __future__ import annotations

import os
import sys
from pathlib import Path

from _junie import check_agents_md


def main() -> int:
    """Check whether `~/.junie/AGENTS.md` matches the compiled rules."""
    home = Path.home()
    system_dir = Path(os.environ.get("SYSTEM_DIR") or Path(__file__).resolve().parent.parent)
    target = home / ".junie" / "AGENTS.md"

    ok, msg = check_agents_md(system_dir, target)
    print(msg)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
