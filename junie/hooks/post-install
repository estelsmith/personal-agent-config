#!/usr/bin/env python3
"""Post-install hook for junie: concatenate junie/rules/*.md and sync ~/.junie/AGENTS.md."""

from __future__ import annotations

import os
import sys
from pathlib import Path

from _junie import sync_agents_md


def main() -> int:
    home = Path.home()
    system_dir = Path(os.environ.get("SYSTEM_DIR") or Path(__file__).resolve().parent.parent)
    target = home / ".junie" / "AGENTS.md"

    ok, msg = sync_agents_md(system_dir, target)
    print(msg)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
