#!/usr/bin/env python3
"""Health check hook for litellm-proxy (.env keys, ~/.bash_profile, and Docker Compose stack)."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

from _bash_profile import check_bash_profile, parse_dotenv


REQUIRED_ENV_KEYS = (
    "LITELLM_MASTER_KEY",
    "ANTHROPIC_API_KEY",
    "GEMINI_API_KEY",
)
PLACEHOLDER_VALUES = {
    "sk-local-change-me",
    "sk-ant-change-me",
    "change-me",
}


def check_env_file(env_path: Path) -> bool:
    if not env_path.is_file():
        print(f"[FAIL] missing {env_path} (run bin/install to seed from .env.example)")
        return False

    env_values = parse_dotenv(env_path)
    ok = True
    for key in REQUIRED_ENV_KEYS:
        val = env_values.get(key, "").strip()
        if not val:
            print(f"[FAIL] {env_path} is missing non-empty {key}")
            ok = False
        elif val in PLACEHOLDER_VALUES:
            print(f"[WARN] {env_path} still has placeholder value for {key}")
    if ok:
        print(f"[OK] {env_path} defines required keys")
    return ok


def parse_compose_ps_json(output: str) -> list[dict]:
    text = output.strip()
    if not text:
        return []
    if text.startswith("["):
        data = json.loads(text)
        return [item for item in data if isinstance(item, dict)]
    items: list[dict] = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        parsed = json.loads(line)
        if isinstance(parsed, dict):
            items.append(parsed)
    return items


def check_http_endpoint(url: str) -> bool:
    try:
        with urllib.request.urlopen(url, timeout=3.0) as resp:
            print(f"[OK] litellm endpoint {url} responded HTTP {resp.status}")
            return True
    except urllib.error.HTTPError as exc:
        if exc.code < 500:
            print(f"[OK] litellm endpoint {url} reachable (HTTP {exc.code})")
            return True
        print(f"[FAIL] litellm endpoint {url} returned HTTP {exc.code}")
        return False
    except Exception as exc:
        print(f"[FAIL] litellm endpoint {url} unreachable: {exc}")
        return False


def main() -> int:
    home = Path.home()
    target_dir = home / "litellm-proxy"
    compose_file = target_dir / "docker-compose.yml"
    env_file = target_dir / ".env"
    bash_profile = home / ".bash_profile"

    ok = True
    if not check_env_file(env_file):
        ok = False

    profile_ok, profile_msg = check_bash_profile(env_file, bash_profile)
    print(profile_msg)
    if not profile_ok:
        ok = False

    if shutil.which("docker") is None:
        print("[FAIL] docker CLI is not installed or not on PATH")
        return 1

    daemon_check = subprocess.run(
        ["docker", "info"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )
    if daemon_check.returncode != 0:
        msg = daemon_check.stderr.strip() or "Docker daemon is not reachable"
        print(f"[FAIL] docker daemon unavailable: {msg}")
        return 1

    if not compose_file.is_file():
        print(f"[FAIL] missing {compose_file}")
        return 1

    base_cmd = [
        "docker",
        "compose",
        "--project-directory",
        str(target_dir),
        "-f",
        str(compose_file),
    ]

    svc_proc = subprocess.run(
        [*base_cmd, "config", "--services"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if svc_proc.returncode != 0:
        print(f"[FAIL] docker compose config failed: {svc_proc.stderr.strip()}")
        return 1

    expected_services = [
        line.strip() for line in svc_proc.stdout.splitlines() if line.strip()
    ]

    ps_proc = subprocess.run(
        [*base_cmd, "ps", "--all", "--format", "json"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if ps_proc.returncode != 0:
        print(f"[FAIL] docker compose ps failed: {ps_proc.stderr.strip()}")
        return 1

    try:
        containers = parse_compose_ps_json(ps_proc.stdout)
    except json.JSONDecodeError as exc:
        print(f"[FAIL] could not parse docker compose ps JSON output: {exc}")
        return 1

    by_service = {c.get("Service"): c for c in containers if c.get("Service")}

    litellm_running = False
    for svc in expected_services:
        container = by_service.get(svc)
        if container is None:
            print(f"[FAIL] service '{svc}' has no container (stack not running)")
            ok = False
            continue

        state = str(container.get("State", "")).lower()
        health = str(container.get("Health", "")).lower()

        if state != "running":
            print(f"[FAIL] service '{svc}' is not running (state={state or 'unknown'})")
            ok = False
            continue

        if health and health != "healthy":
            print(f"[FAIL] service '{svc}' is unhealthy (state={state}, health={health})")
            ok = False
            continue

        health_label = health if health else "no healthcheck"
        print(f"[OK] service '{svc}' running ({health_label})")
        if svc == "litellm":
            litellm_running = True

    if litellm_running:
        health_url = os.environ.get(
            "LITELLM_HEALTH_URL", "http://127.0.0.1:4000/health/liveliness"
        )
        if not check_http_endpoint(health_url):
            ok = False

    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
