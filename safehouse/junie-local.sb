;; ---------------------------------------------------------------------------
;; Machine-local Agent Safehouse appended profile for junie-safehouse-gemini-ladder
;; Appended via: safehouse --append-profile="$HOME/.config/safehouse/junie-local.sb"
;; ---------------------------------------------------------------------------

;; Custom Homebrew prefix (~/.homebrew), npm global prefix (~/npm), ~/bin, and ~/.docmancer
(allow file-read-metadata
    (home-literal "")
    (home-literal "/.homebrew")
    (home-literal "/npm")
    (home-literal "/bin")
    (home-literal "/.docmancer")
)

(allow file-read*
    (home-subpath "/.homebrew")
    (home-subpath "/npm")
    (home-subpath "/bin")
    (home-literal "/.gitignore_global")
)

;; Docmancer config, SQLite/vector stores, extracted pages, and embeddings cache
(allow file-read* file-write*
    (home-subpath "/.docmancer")
)
