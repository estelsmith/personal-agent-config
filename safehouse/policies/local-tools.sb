;; Custom Homebrew prefix (~/.homebrew), npm global prefix (~/npm), ~/bin, and global gitignore.
(allow file-read-metadata
    (home-literal "")
    (home-literal "/.homebrew")
    (home-literal "/npm")
    (home-literal "/bin")
)

(allow file-read*
    (home-subpath "/.homebrew")
    (home-subpath "/npm")
    (home-subpath "/bin")
    (home-literal "/.gitignore_global")
)
