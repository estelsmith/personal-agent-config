#!/usr/bin/env python3
"""Post-install hook for safehouse: render acp.json with ${HOME} and sync ~/.jetbrains/acp.json."""

from __future__ import annotations

import os
import sys
from pathlib import Path

from _safehouse import sync_acp_json


def main() -> int:
    home = Path.home()
    system_dir = Path(os.environ.get("SYSTEM_DIR") or Path(__file__).resolve().parent.parent)
    target = home / ".jetbrains" / "acp.json"

    ok, msg = sync_acp_json(system_dir, target, home=home)
    print(msg)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
