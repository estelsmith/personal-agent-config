#!/usr/bin/env python3
"""Post-install hook for `safehouse` to render `policies/*.sb` and `acp.json`."""

from __future__ import annotations

import os
import sys
from pathlib import Path

from _safehouse import sync_acp_json, sync_local_profile


def main() -> int:
    """Sync `~/.config/safehouse/junie-local.sb` and `~/.jetbrains/acp.json`."""
    home = Path.home()
    system_dir = Path(os.environ.get("SYSTEM_DIR") or Path(__file__).resolve().parent.parent)
    profile_target = home / ".config" / "safehouse" / "junie-local.sb"
    acp_target = home / ".jetbrains" / "acp.json"

    profile_ok, profile_msg = sync_local_profile(system_dir, profile_target)
    print(profile_msg)

    acp_ok, acp_msg = sync_acp_json(system_dir, acp_target, home=home)
    print(acp_msg)

    return 0 if (profile_ok and acp_ok) else 1


if __name__ == "__main__":
    sys.exit(main())
